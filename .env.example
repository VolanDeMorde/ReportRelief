# ReportRelief — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.

# Firebase
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXX

# generateReport Cloud Function URL
VITE_FUNCTION_URL=https://<region>-<project>.cloudfunctions.net/generateReport

# Stripe price IDs (checkout runs through the Firebase Stripe extension;
# no Stripe keys belong in this file)
VITE_STRIPE_PRICE_MONTHLY=price_...
VITE_STRIPE_PRICE_YEARLY=price_...

# GEMINI_API_KEY is NOT read by the frontend. Set it as a Functions secret:
#   firebase functions:secrets:set GEMINI_API_KEY
